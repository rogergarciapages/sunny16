{
  "$schema": "https://schemas.agenticweb.org/v1/ai-catalog.json",
  "name": "Sunny 16 Rule Calculator",
  "description": "Meterless film exposure, shutter speed, optical filter, and depth of field calculator for analog photography.",
  "url": "https://sunny16rule.com",
  "version": "1.0.0",
  "capabilities": [
    {
      "id": "sunny16-exposure-calculation",
      "name": "Sunny 16 Exposure Calculation",
      "description": "Calculates aperture, shutter speed, and optical filter exposure compensation for daylight film photography based on weather condition and ISO.",
      "type": "calculator",
      "parameters": {
        "filmIso": {
          "type": "number",
          "description": "Film speed in ISO/ASA (e.g. 100, 400, 800)"
        },
        "condition": {
          "type": "string",
          "enum": [
            "snow_sand",
            "sunny",
            "slight_overcast",
            "overcast",
            "heavy_overcast",
            "open_shade",
            "golden_hour",
            "blue_hour",
            "indoor_night"
          ]
        },
        "filters": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Stacked optical filters (e.g. ['yellow', 'cpl', 'nd4'])"
        }
      }
    }
  ],
  "links": {
    "documentation": "https://sunny16rule.com/llms.txt",
    "home": "https://sunny16rule.com"
  }
}
